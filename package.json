{
  "name": "sigtau",
  "version": "1.0.0",
  "private": true,
  "description": "SIGTAU · Sistema de Gestión de Tutorías Académicas Universitarias (Universidad de El Salvador)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "api": "node server/index.mjs",
    "api:watch": "node --watch server/index.mjs",
    "dev:full": "concurrently -n api,web -c cyan,magenta \"npm:api:watch\" \"npm:dev\"",
    "db:create": "node database/create.mjs",
    "db:seed": "node database/seed.mjs",
    "db:reset": "node database/create.mjs --reset && node database/seed.mjs",
    "db:admin": "node database/create-admin.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.5",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
